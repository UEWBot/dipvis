#: tournament/game_scoring/maxonian.py:51
#, python-format
msgid ""
"\n"
"                 Players are ranked by supply centre count.\n"
"                 Top-ranked player gets 7 points, second gets 6, third gets "
"5,\n"
"                 fourth gets 4, fifth gets 3, sixth gets 2, and last gets "
"1.\n"
"                 If two players are tied, their SC counts in previous years\n"
"                 are compared, and the player who most recently was ahead "
"gets\n"
"                 the higher score.\n"
"                 If two players had the same supply centre count every "
"year,\n"
"                 they each score the average of their place and the place "
"below.\n"
"                 Any player with more than %(threshold)d supply centres "
"scores 1 additional\n"
"                 point per SC above that threshold, unless the game was "
"soloed,\n"
"                 in which case only the soloer gets these points.\n"
"                 "
msgstr ""

