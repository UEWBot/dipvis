[run]
branch = True
plugins = django_coverage_plugin

source =
    tournament/
    visualiser/

omit =
    tournament/migrations/*.py
    */README.txt
    tournament/players/testdata/*

[report]
exclude_lines =
    pragma: no cover
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    @(abc\.)?abstractmethod

skip_covered = True

skip_empty = True
